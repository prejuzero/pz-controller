# Dependências
node_modules/

# Builds e caches
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo

# Configuração local de ferramentas de IA (cada pessoa configura a sua)
.mcp.json

# Ambiente (nunca commitar segredos)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema e editores
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Terraform: estado, planos e variáveis locais nunca são versionados
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
**/backend.hcl
**/terraform.tfvars

# Cliente Prisma gerado (pnpm --filter @pz/db gerar)
packages/db/src/gerado/

# Storybook e testes visuais do @pz/ui (falhas e build estático)
storybook-static/
.vitest/
# Tipos gerados pelo Next.js (next typegen/dev/build)
next-env.d.ts

# E2E do portal (Playwright): sessão, relatório e resultados locais
apps/web/e2e/.sessao/
apps/web/e2e/.relatorio/
apps/web/e2e/.resultados/
