{
  "name": "@pz/web",
  "version": "0.0.0",
  "private": true,
  "description": "Portal web (Next.js App Router): consome a API /v1 só pelo cliente gerado do OpenAPI (ADR-009, ADR-015).",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "dev": "next dev --webpack -p 3001",
    "lint": "next typegen && eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "e2e": "./scripts/e2e.sh",
    "e2e:atualizar": "./scripts/e2e.sh --update-snapshots"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@pz/contracts": "workspace:*",
    "@pz/ui": "workspace:*",
    "@sentry/browser": "11.10.0",
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.0",
    "@pz/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
