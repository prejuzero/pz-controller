{
  "name": "@pz/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker (NestJS standalone): consumidores de eventos, relay do outbox e, a partir da HU10, filas.",
  "type": "module",
  "scripts": {
    "build": "pz-build-app",
    "start": "node --enable-source-maps --import ./dist/instrumentacao.js dist/main.js",
    "dev": "node --env-file=../../.env.example --env-file-if-exists=../../.env --watch --import tsx --import ./src/instrumentacao.ts src/main.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@pz/adapter-s3": "workspace:*",
    "@pz/adapter-smtp": "workspace:*",
    "@pz/auditoria": "workspace:*",
    "@pz/calendario": "workspace:*",
    "@pz/config": "workspace:*",
    "@pz/contracts": "workspace:*",
    "@pz/db": "workspace:*",
    "@pz/identidade": "workspace:*",
    "@pz/integracoes": "workspace:*",
    "@pz/kernel": "workspace:*",
    "@pz/notificacoes": "workspace:*",
    "@pz/observability": "workspace:*",
    "@pz/saude": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "files": [
    "dist"
  ]
}
