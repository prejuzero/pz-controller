{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^gerar", "gerar"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^gerar", "gerar"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^gerar", "gerar"]
    },
    "test": {
      "dependsOn": ["^build", "^gerar", "gerar"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build", "^gerar", "gerar"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "gerar": {
      "outputs": ["src/gerado/**"]
    }
  }
}
