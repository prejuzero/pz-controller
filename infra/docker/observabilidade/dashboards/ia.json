{
  "uid": "pz-ia",
  "title": "PrejuZero · IA",
  "description": "Uso, qualidade e disponibilidade da plataforma de IA (HU58). Custo por tenant: traces no Tempo (atributo pz.tenant_id). Runbook: docs/runbooks/alertas.md",
  "tags": ["prejuzero"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "servico",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info, service_name)",
          "refId": "servico"
        },
        "definition": "label_values(target_info, service_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tokens por dia, tarefa e tipo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (tarefa, tipo) (increase(pz_ia_tokens_total{job=~\"$servico\"}[1d]))",
          "legendFormat": "{{tarefa}} · {{tipo}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Saídas inválidas (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * sum by (tarefa) (rate(pz_ia_chamada_duracao_seconds_count{job=~\"$servico\",resultado=\"saida-invalida\"}[15m])) / sum by (tarefa) (rate(pz_ia_chamada_duracao_seconds_count{job=~\"$servico\"}[15m]))",
          "legendFormat": "{{tarefa}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fallbacks acionados por modelo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (tarefa, modelo) (increase(pz_ia_fallbacks_total{job=~\"$servico\"}[1h]))",
          "legendFormat": "{{tarefa}} · {{modelo}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência p95 por tarefa",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tarefa) (rate(pz_ia_chamada_duracao_seconds_bucket{job=~\"$servico\"}[5m])))",
          "legendFormat": "{{tarefa}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Correções pelos advogados (% das sugestões)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * sum by (tarefa) (increase(pz_ia_correcoes_total{job=~\"$servico\"}[1d])) / sum by (tarefa) (increase(pz_ia_chamada_duracao_seconds_count{job=~\"$servico\",resultado=\"sucesso\"}[1d]))",
          "legendFormat": "{{tarefa}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tarefas sem modelo disponível",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (tarefa) (increase(pz_ia_tarefas_sem_modelo_total{job=~\"$servico\"}[1h]))",
          "legendFormat": "{{tarefa}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Alertas de orçamento (uso acima de 80%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (tarefa) (increase(pz_ia_orcamento_alertas_total{job=~\"$servico\"}[1d]))",
          "legendFormat": "{{tarefa}}"
        }
      ]
    }
  ]
}
