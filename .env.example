# Variáveis do ambiente local (HU02). Copie para .env só se precisar mudar algo:
# o docker compose e as apps já usam estes mesmos valores como padrão.
# Nunca coloque segredos reais aqui: este arquivo é versionado.

NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# PostgreSQL
POSTGRES_USER=pz_dev
POSTGRES_PASSWORD=pz_dev_local
POSTGRES_DB=prejuzero
POSTGRES_PORT=5432
# Papéis (ADR-003): a aplicação usa pz_app (sem BYPASSRLS); migrações usam pz_migrator; jobs
# globais e seeds usam pz_sistema. pz_dev é o superusuário do contêiner local, só para administração.
DATABASE_URL=postgresql://pz_app:pz_app_local@127.0.0.1:5432/prejuzero
DATABASE_URL_MIGRACAO=postgresql://pz_migrator:pz_migrator_local@127.0.0.1:5432/prejuzero
DATABASE_URL_SISTEMA=postgresql://pz_sistema:pz_sistema_local@127.0.0.1:5432/prejuzero

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Cifragem de segredos da aplicação (ex.: 2FA), 32 bytes em base64. Gere a sua:
#   openssl rand -base64 32
# Em produção vem do cofre/KMS (HU72). Nunca reutilize a chave de outro ambiente.
CHAVE_CIFRAGEM=

# Armazenamento S3-compatível (RustFS local, ADR-017)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pz_dev
S3_SECRET_ACCESS_KEY=pz_dev_local_secret
S3_FORCE_PATH_STYLE=true

# E-mail local (Mailpit: http://127.0.0.1:8025)
SMTP_PORT=1025
SMTP_HOST=127.0.0.1
MAILPIT_UI_PORT=8025

# Observabilidade local (perfil opcional: pnpm infra:up:obs)
GRAFANA_PORT=3001
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Captura de erros no Sentry: desligada sem DSN (nada sai da máquina).
# SENTRY_DSN=

# Alertas (perfil de observabilidade). Localmente o e-mail chega ao Mailpit, não à caixa real.
ALERTAS_EMAIL=prejuzero@gmail.com
# Webhook do canal do Discord: é um segredo. Defina só no .env (nunca no repositório).
# ALERTAS_DISCORD_WEBHOOK_URL=

# Apps em container (pnpm infra:up:apps). Com a observabilidade no ar, envie a telemetria:
# APPS_OTEL_ENDPOINT=http://observabilidade:4318
API_PORT=3000
WORKER_PORT=3002

# Portal (apps/web, porta 3001): encaminha /v1 para a API na mesma origem (cookies __Host-).
# API_URL=http://localhost:3000
# Sentry no navegador; vazio desliga o envio.
# NEXT_PUBLIC_SENTRY_DSN=
# Contato do encarregado (DPO) na política de privacidade (HU38); vazio esconde a linha.
# NEXT_PUBLIC_ENCARREGADO_EMAIL=

# LGPD (HU38). Tenant técnico das leituras públicas (padrão: o do seed local) e bucket dos
# arquivos exportados. Prazos de retenção em dias (decisão de 07/10/2026, a confirmar com o
# jurídico): acessos 1 ano, provas de escritório encerrado 5 anos.
# TENANT_PLATAFORMA_ID=01a10e00-0000-7000-8000-00000000c001
# ARQUIVOS_BUCKET=pz-arquivos
# RETENCAO_ACESSOS_DIAS=365
# RETENCAO_PROVAS_DIAS=1826
