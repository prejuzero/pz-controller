{
  "name": "@pz/adapter-s3",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptador ArmazenamentoArquivos S3-compatível (RustFS local, Amazon S3), ADR-005/010/017.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@pz/integracoes": "workspace:*",
    "@pz/kernel": "workspace:*"
  },
  "devDependencies": {
    "@pz/config": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
