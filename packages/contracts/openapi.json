{
  "openapi": "3.1.0",
  "info": {
    "title": "PrejuZero API",
    "version": "1",
    "description": "API do PrejuZero. Erros em application/problem+json (RFC 9457), paginação por cursor e Idempotency-Key em operações sensíveis (ADR-009)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v1/auth/2fa/ativar": {
      "post": {
        "operationId": "ativarSegundoFator",
        "summary": "Ativa o 2FA e devolve os códigos de recuperação.",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodigoSegundoFator"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegundoFatorAtivado"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "409": {
            "description": "Conflito com o estado atual.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/2fa/configurar": {
      "post": {
        "operationId": "configurarSegundoFator",
        "summary": "Gera o segredo TOTP e a URI do QR code.",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracaoSegundoFator"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "409": {
            "description": "Conflito com o estado atual.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/2fa/verificar": {
      "post": {
        "operationId": "verificarSegundoFator",
        "summary": "Verifica o código do aplicativo ou de recuperação.",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodigoSegundoFator"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoAtual"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/entrar": {
      "post": {
        "operationId": "entrar",
        "summary": "Entra com e-mail e senha; a sessão nasce aguardando o 2FA.",
        "tags": [
          "auth"
        ],
        "security": [],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credenciais"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoAtual"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/eu": {
      "get": {
        "operationId": "consultarSessao",
        "summary": "Usuário, tenant e nível da sessão atual.",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoAtual"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sair": {
      "post": {
        "operationId": "sair",
        "summary": "Encerra a sessão atual.",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sucesso, sem corpo."
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/saude": {
      "get": {
        "operationId": "consultarSituacao",
        "summary": "Situação da API, para clientes verificarem a conexão.",
        "tags": [
          "saude"
        ],
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SituacaoDaApi"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{adaptador}": {
      "post": {
        "operationId": "receberWebhook",
        "summary": "Recebe o webhook de um provedor (assinatura verificada pelo adaptador).",
        "tags": [
          "integracoes"
        ],
        "security": [],
        "parameters": [
          {
            "name": "adaptador",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookAceito"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CodigoSegundoFator": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 6,
            "maxLength": 16,
            "description": "6 dígitos do aplicativo ou um código de recuperação (XXXXX-XXXXX)."
          }
        },
        "required": [
          "codigo"
        ],
        "additionalProperties": false
      },
      "ConfiguracaoSegundoFator": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "URI otpauth:// para o QR code do aplicativo autenticador."
          },
          "segredo": {
            "type": "string",
            "description": "O mesmo segredo, para digitar manualmente."
          }
        },
        "required": [
          "uri",
          "segredo"
        ],
        "additionalProperties": false
      },
      "Credenciais": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "senha"
        ],
        "additionalProperties": false
      },
      "Problema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI que identifica o tipo do problema."
          },
          "title": {
            "type": "string",
            "description": "Resumo legível, em pt-BR."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "codigo": {
            "type": "string",
            "description": "Código estável do erro (ex.: prazo.ja-confirmado)."
          },
          "problemas": {
            "description": "Problemas por campo, nos erros de validação.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensagem": {
                  "type": "string"
                }
              },
              "required": [
                "campo",
                "mensagem"
              ],
              "additionalProperties": false
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "codigo"
        ],
        "additionalProperties": false
      },
      "SegundoFatorAtivado": {
        "type": "object",
        "properties": {
          "sessao": {
            "$ref": "#/components/schemas/SessaoAtual"
          },
          "codigosDeRecuperacao": {
            "minItems": 10,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exibidos só agora: cada um vale uma vez se o celular for perdido."
          }
        },
        "required": [
          "sessao",
          "codigosDeRecuperacao"
        ],
        "additionalProperties": false
      },
      "SessaoAtual": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "nivel": {
            "type": "string",
            "enum": [
              "senha",
              "completo"
            ],
            "description": "`senha`: falta o 2FA; `completo`: senha e 2FA verificados."
          },
          "proximoPasso": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "configurar-2fa",
                  "verificar-2fa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "O que falta para a sessão ficar completa; null quando já está."
          }
        },
        "required": [
          "usuarioId",
          "tenantId",
          "nivel",
          "proximoPasso"
        ],
        "additionalProperties": false
      },
      "SituacaoDaApi": {
        "type": "object",
        "properties": {
          "situacao": {
            "type": "string",
            "enum": [
              "operacional",
              "degradada"
            ]
          },
          "versao": {
            "type": "string",
            "description": "Versão implantada (SHA do commit)."
          },
          "verificadoEm": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "situacao",
          "versao",
          "verificadoEm"
        ],
        "additionalProperties": false
      },
      "WebhookAceito": {
        "type": "object",
        "properties": {
          "duplicado": {
            "type": "boolean",
            "description": "O mesmo webhook (ID externo) já tinha sido recebido."
          }
        },
        "required": [
          "duplicado"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessao": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pz_sessao"
      },
      "oauth2": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token OAuth 2.1 (ADR-015)."
      }
    }
  },
  "security": [
    {
      "sessao": []
    },
    {
      "oauth2": []
    }
  ]
}
