// Schema do PrejuZero (HU05, ADR-003). Convenções:
// - tabelas e colunas em snake_case (@@map/@map); modelos em PascalCase no código;
// - PK UUIDv7 gerada pela aplicação (@pz/kernel), nunca pelo banco;
// - criado_em e atualizado_em em timestamptz;
// - toda tabela de negócio tem tenant_id NOT NULL com FK e RLS (pz_habilitar_rls na migração).
// Mudanças: gere o SQL com `prisma migrate diff`, escreva o down.sql e siga expand/contract (README).

generator client {
  provider = "prisma-client"
  output   = "../src/gerado/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoTenant {
  autonomo
  escritorio
  /// Tenant interno do PrejuZero (curador, administração), dono da trilha dos dados globais.
  plataforma

  @@map("tipo_tenant")
}

/// Escritório ou advogado autônomo: a unidade de isolamento de dados (RNF07).
enum SituacaoAssinatura {
  teste
  ativa
  inadimplente
  cancelada

  @@map("situacao_assinatura")
}

model Tenant {
  id                 String             @id @db.Uuid
  nome               String
  tipo               TipoTenant
  criadoEm           DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  /// Encerramento efetivado (HU38): dados de negócio apagados, provas pseudonimizadas.
  encerradoEm        DateTime?          @map("encerrado_em") @db.Timestamptz(6)
  /// Plano e situação da assinatura, manuais no MVP (HU39; gateway futuro via ProvedorCobranca).
  plano              String?
  situacaoAssinatura SituacaoAssinatura @default(teste) @map("situacao_assinatura")
  /// Suspensão do acesso pelo administrador (HU39): login e renovação recusados; captura segue.
  suspensoEm         DateTime?          @map("suspenso_em") @db.Timestamptz(6)
  motivoSuspensao    String?            @map("motivo_suspensao")

  usuarios               Usuario[]
  eventosDominio         EventoDominio[]
  eventosProcessados     EventoProcessado[]
  acessos                Acesso[]
  dispositivos           SessaoDispositivo[]
  clientesOauth          ClienteOauth[]
  convites               ConviteMembro[]
  assinaturasWebhook     AssinaturaWebhook[]
  entregasWebhook        EntregaWebhook[]
  perfis                 UsuarioPerfil[]
  auditoria              EventoAuditoria[]
  verificacao            AuditoriaVerificacao?
  feriadosLocais         FeriadoLocal[]
  advogados              Advogado[]
  notificacoes           Notificacao[]
  assinaturasDeAlvo      AlvoAssinante[]
  aceitesDocumentos      AceiteDocumento[]
  exportacoes            ExportacaoDados[]
  dadosPessoaisAuditoria AuditoriaDadoPessoal[]
  preferencias           PreferenciaNotificacao[]
  consentimentos         ConsentimentoCanal[]
  destinosPush           DestinoPush[]
  oabs                   Oab[]
  clientes               Cliente[]
  processos              Processo[]
  encerramento           EncerramentoConta?
  publicacoes            PublicacaoDestinatario[]
  prazos                 Prazo[]
  compromissos           Compromisso[]
  relatorios             Relatorio[]
  importacoesDeProcessos ImportacaoProcesso[]
  nomesMonitorados       NomeMonitorado[]
  feedsDaAgenda          FeedAgenda[]
  verificacoesHistorico  VerificacaoHistorico[]
  enviosManuais          EnvioManual[]
  conferencias           ConferenciaPainel[]
  lembretes              LembreteAgendado[]
  tokenCiencias          TokenCiencia[]
  cienciaPrazos          CienciaPrazo[]

  @@map("tenant")
}

/// Usuário do portal. Identidade, CPF, 2FA e perfis chegam na HU06.
model Usuario {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  nome               String
  email              String
  /// Hash Argon2id em formato PHC; null = ainda sem senha (HU06).
  senhaHash          String?   @map("senha_hash")
  /// 2FA TOTP: segredo cifrado (AES-256-GCM), ativação, último passo aceito e códigos de recuperação (hash).
  totpSegredoCifrado String?   @map("totp_segredo_cifrado")
  totpAtivoEm        DateTime? @map("totp_ativo_em") @db.Timestamptz(6)
  totpUltimoPasso    BigInt?   @map("totp_ultimo_passo")
  codigosRecuperacao String[]  @default([]) @map("codigos_recuperacao")
  /// Quando o titular confirmou o e-mail pelo link do cadastro (HU11); nulo = não verificado.
  emailVerificadoEm  DateTime? @map("email_verificado_em") @db.Timestamptz(6)
  /// Membro desativado pelo administrador do escritório (HU41): não entra mais.
  desativadoEm       DateTime? @map("desativado_em") @db.Timestamptz(6)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  acessos         Acesso[]
  dispositivos    SessaoDispositivo[]
  clientesOauth   ClienteOauth[]
  perfis          UsuarioPerfil[]
  convitesAceitos ConviteMembro[]
  advogado        Advogado?

  feedsDaAgenda FeedAgenda[]

  @@unique([tenantId, email])
  @@map("usuario")
}

/// Outbox transacional (ADR-004): gravado na mesma transação da mudança de negócio.
model EventoDominio {
  id          String    @id @db.Uuid
  tipo        String
  versao      Int
  tenantId    String    @map("tenant_id") @db.Uuid
  agregadoId  String    @map("agregado_id")
  payload     Json      @db.JsonB
  /// Contexto de trace e correlação propagado até o consumidor (HU03).
  contexto    Json?     @db.JsonB
  ocorridoEm  DateTime  @map("ocorrido_em") @db.Timestamptz(6)
  publicadoEm DateTime? @map("publicado_em") @db.Timestamptz(6)
  tentativas  Int       @default(0)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("evento_dominio")
}

/// Deduplicação dos consumidores (ADR-004): um evento é processado uma vez por consumidor.
model EventoProcessado {
  consumidor   String
  eventoId     String   @map("evento_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  processadoEm DateTime @default(now()) @map("processado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([consumidor, eventoId])
  @@index([tenantId])
  @@index([processadoEm])
  @@map("evento_processado")
}

/// Webhook de entrada com o corpo bruto (HU09, ADR-005). Global: o tenant só é conhecido no
/// processamento. pz_app só insere; pz_sistema lê e processa.
model WebhookRecebido {
  id            String    @id @db.Uuid
  adaptador     String
  idExterno     String    @map("id_externo")
  cabecalhos    Json      @db.JsonB
  corpo         Bytes
  recebidoEm    DateTime  @default(now()) @map("recebido_em") @db.Timestamptz(6)
  enfileiradoEm DateTime? @map("enfileirado_em") @db.Timestamptz(6)
  processadoEm  DateTime? @map("processado_em") @db.Timestamptz(6)

  @@unique([adaptador, idExterno])
  @@map("webhook_recebido")
}

/// Registro de acessos (HU06): login, 2FA, logout e bloqueios. IP e user agent são dados pessoais.
model Acesso {
  id         String     @id @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  usuarioId  String     @map("usuario_id") @db.Uuid
  tipo       TipoAcesso
  sucesso    Boolean
  ip         String
  userAgent  String     @map("user_agent")
  ocorridoEm DateTime   @map("ocorrido_em") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([usuarioId, ocorridoEm(sort: Desc)])
  @@map("acesso")
}

enum TipoAcesso {
  login
  segundo_fator @map("segundo-fator")
  logout
  bloqueio

  @@map("tipo_acesso")
}

enum TipoCliente {
  web
  mobile
  mcp
  integrador

  @@map("tipo_cliente")
}

/// Sessão de um dispositivo (HU06): token de acesso curto + renovação rotativa, revogável.
model SessaoDispositivo {
  id              String      @id @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  usuarioId       String      @map("usuario_id") @db.Uuid
  tipoCliente     TipoCliente @map("tipo_cliente")
  nomeDispositivo String      @map("nome_dispositivo")
  criadoEm        DateTime    @map("criado_em") @db.Timestamptz(6)
  ultimoUso       DateTime    @map("ultimo_uso") @db.Timestamptz(6)
  revogadaEm      DateTime?   @map("revogada_em") @db.Timestamptz(6)
  /// Nascida de uma autorização OAuth (HU49): revogar o cliente revoga a sessão.
  clienteOauthId  String?     @map("cliente_oauth_id") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  clienteOauth ClienteOauth? @relation(fields: [clienteOauthId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([usuarioId])
  @@index([clienteOauthId])
  @@map("sessao_dispositivo")
}

/// Cliente OAuth 2.1 de integrador (HU49): Client Credentials, segredo só como hash, revogável.
model ClienteOauth {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  usuarioId          String    @map("usuario_id") @db.Uuid
  nome               String
  segredoHash        String?   @map("segredo_hash")
  escopos            String[]
  /// `confidencial` (Client Credentials) ou `publico` (Authorization Code + PKCE).
  tipo               String    @default("confidencial")
  redirectUris       String[]  @default([]) @map("redirect_uris")
  /// Cliente criado na autorização de um registro dinâmico (HU60).
  registroDinamicoId String?   @map("registro_dinamico_id") @db.Uuid
  ultimoUso          DateTime? @map("ultimo_uso") @db.Timestamptz(6)
  revogadoEm         DateTime? @map("revogado_em") @db.Timestamptz(6)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  usuario          Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  registroDinamico RegistroOauthDinamico? @relation(fields: [registroDinamicoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispositivos     SessaoDispositivo[]

  @@index([tenantId])
  @@map("cliente_oauth")
}

/// Registro dinâmico de cliente OAuth (HU60, RFC 7591): global, sem acesso até a autorização.
model RegistroOauthDinamico {
  id           String   @id @db.Uuid
  nome         String
  redirectUris String[] @map("redirect_uris")
  /// App oficial do PrejuZero (HU65): registro fixo da migração.
  appOficial   Boolean  @default(false) @map("app_oficial")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  clientes ClienteOauth[]

  @@map("registro_oauth_dinamico")
}

/// Convite para entrar na equipe do escritório (HU41): só o hash do token, uso único, 7 dias.
model ConviteMembro {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  nome         String
  perfil       String
  tokenHash    String    @unique @map("token_hash")
  criadoPor    String    @map("criado_por") @db.Uuid
  expiraEm     DateTime  @map("expira_em") @db.Timestamptz(6)
  aceitoEm     DateTime? @map("aceito_em") @db.Timestamptz(6)
  canceladoEm  DateTime? @map("cancelado_em") @db.Timestamptz(6)
  usuarioId    String?   @map("usuario_id") @db.Uuid
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dono    Perfil   @relation(fields: [perfil], references: [codigo], onDelete: Restrict, onUpdate: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("convite_membro")
}

/// Assinatura de webhook de saída (HU49): eventos públicos para o endereço do escritório.
model AssinaturaWebhook {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  url            String
  descricao      String
  eventos        String[]
  segredoCifrado String    @map("segredo_cifrado")
  criadoPor      String    @map("criado_por") @db.Uuid
  desativadaEm   DateTime? @map("desativada_em") @db.Timestamptz(6)
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entregas EntregaWebhook[]

  @@unique([tenantId, id])
  @@map("assinatura_webhook")
}

/// Entrega de um evento a uma assinatura (HU49): uma por (assinatura, evento).
model EntregaWebhook {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  assinaturaId String    @map("assinatura_id") @db.Uuid
  eventoId     String    @map("evento_id") @db.Uuid
  tipo         String
  ocorridoEm   DateTime  @map("ocorrido_em") @db.Timestamptz(6)
  dados        Json
  situacao     String    @default("pendente")
  tentativas   Int       @default(0)
  ultimoStatus Int?      @map("ultimo_status")
  ultimoErro   String?   @map("ultimo_erro")
  entregueEm   DateTime? @map("entregue_em") @db.Timestamptz(6)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assinatura AssinaturaWebhook @relation(fields: [tenantId, assinaturaId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assinaturaId, eventoId])
  @@index([tenantId, criadoEm(sort: Desc)])
  @@map("entrega_webhook")
}

/// Trilha de auditoria imutável (HU08, ADR-006): só INSERT, cadeia SHA-256 por tenant.
/// Particionada por mês no banco (pg_partman); o Prisma vê a tabela-mãe.
model EventoAuditoria {
  id            String   @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  sequencia     BigInt
  tipo          String
  entidade      String
  entidadeId    String   @map("entidade_id")
  usuarioId     String?  @map("usuario_id") @db.Uuid
  usuarioRealId String?  @map("usuario_real_id") @db.Uuid
  canal         String
  ip            String?
  userAgent     String?  @map("user_agent")
  antes         Json?    @db.JsonB
  depois        Json?    @db.JsonB
  /// Referências aos dados pessoais (ADR-018), campo -> id em auditoria_dado_pessoal.
  dadosPessoais Json?    @map("dados_pessoais") @db.JsonB
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  hashAnterior  String   @map("hash_anterior")
  hash          String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([id, criadoEm])
  @@index([tenantId, entidade, entidadeId, criadoEm], map: "evento_auditoria_entidade_idx")
  @@index([tenantId, sequencia], map: "evento_auditoria_sequencia_idx")
  @@map("evento_auditoria")
}

/// Checkpoint da verificação e da cópia WORM da auditoria (HU08): âncora do último elo conferido.
model AuditoriaVerificacao {
  tenantId        String   @id @map("tenant_id") @db.Uuid
  ultimaSequencia BigInt   @map("ultima_sequencia")
  ultimoHash      String   @map("ultimo_hash")
  ultimaExportada BigInt   @default(0) @map("ultima_exportada")
  verificadoEm    DateTime @default(now()) @map("verificado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("auditoria_verificacao")
}

enum RamoProcessual {
  civel
  juizados
  trabalhista
  penal
  juizado_criminal

  @@map("ramo_processual")
}

enum ContagemPrazo {
  uteis
  corridos

  @@map("contagem_prazo")
}

enum PoliticaDobro {
  entes_cpc
  so_defensoria
  fazenda_para_recorrer
  nao_dobra
  verificar

  @@map("politica_dobro")
}

enum CalculoPrazo {
  automatico
  data_informada
  nao_calcula

  @@map("calculo_prazo")
}

enum LocalDoAto {
  orgao_do_processo
  juizo_de_origem
  tribunal_de_segundo_grau
  orgao_da_decisao
  tribunal_superior
  nao_se_aplica

  @@map("local_do_ato")
}

enum UnidadePrazo {
  dias
  horas
  meses
  anos

  @@map("unidade_prazo")
}

enum StatusTabelaPrazo {
  rascunho
  aprovado

  @@map("status_tabela_prazo")
}

/// Taxonomia única de tipos de ato (HU15): regras rápidas, IA e portal. Global, mantida pelo curador.
model TipoAto {
  codigo       String   @id
  nome         String
  descricao    String
  sinonimos    String[] @default([])
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  versoes        TabelaPrazo[]
  regras         RegraClassificacao[]
  classificacoes Classificacao[]

  @@map("tipo_ato")
}

/// Regra rápida de classificação (HU20): versão imutável; vigente = maior versão ativa por código.
model RegraClassificacao {
  codigo       String
  versao       Int
  tipoAto      String    @map("tipo_ato")
  padroes      String[]
  confianca    Decimal   @db.Decimal(3, 2)
  ativa        Boolean   @default(true)
  /// Curadoria pelo portal (PZ-313): quem propôs e quem ativou (pessoas diferentes).
  propostaPor  String?   @map("proposta_por") @db.Uuid
  ativadaPor   String?   @map("ativada_por") @db.Uuid
  ativadaEm    DateTime? @map("ativada_em") @db.Timestamptz(6)
  retiradaEm   DateTime? @map("retirada_em") @db.Timestamptz(6)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tipo TipoAto @relation(fields: [tipoAto], references: [codigo], onDelete: Restrict, onUpdate: Restrict)

  @@id([codigo, versao])
  @@map("regra_classificacao")
}

/// Tabela de prazos por ato e ramo (HU15, ADR-007): versões com vigência e aprovação por quatro
/// olhos. Global; versão aprovada é imutável (trigger pz_tabela_prazo_imutavel).
/// Classificação de um conteúdo de publicação (HU21): uma por conteúdo global; nunca uma data.
/// Resumo da publicação por IA (HU62): um por conteúdo global; trechos literais do teor.
model ResumoPublicacao {
  conteudoId   String   @id @map("conteudo_id") @db.Uuid
  situacao     String
  texto        String?
  providencia  String?
  trechos      String[] @default([])
  modelo       String?
  versaoPrompt String?  @map("versao_prompt")
  motivo       String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("resumo_publicacao")
}

model Classificacao {
  conteudoId   String   @id @map("conteudo_id") @db.Uuid
  origem       String
  situacao     String
  tipoAto      String?  @map("tipo_ato")
  confianca    Decimal? @db.Decimal(3, 2)
  prazoCitado  Json?    @map("prazo_citado") @db.JsonB
  evidencias   Json     @default("[]") @db.JsonB
  regraCodigo  String?  @map("regra_codigo")
  regraVersao  Int?     @map("regra_versao")
  versaoPrompt String?  @map("versao_prompt")
  modelo       String?
  motivo       String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tipo TipoAto? @relation(fields: [tipoAto], references: [codigo], onDelete: Restrict, onUpdate: Restrict)

  @@index([situacao], map: "classificacao_situacao_idx")
  @@map("classificacao")
}

/// Uso de IA da plataforma por dia (Brasília), tarefa e modelo, com custo estimado (HU21).
model UsoIa {
  dia              DateTime @db.Date
  tarefa           String
  modelo           String
  chamadas         Int      @default(0)
  tokensEntrada    BigInt   @default(0) @map("tokens_entrada")
  tokensSaida      BigInt   @default(0) @map("tokens_saida")
  tokensCacheLidos BigInt   @default(0) @map("tokens_cache_lidos")
  custoEstimadoUsd Decimal  @default(0) @map("custo_estimado_usd") @db.Decimal(14, 6)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@id([dia, tarefa, modelo])
  @@map("uso_ia")
}

/// Versão mínima de cliente por plataforma (HU63): global; abaixo dela, 426.
model VersaoMinimaCliente {
  plataforma   String   @id
  versao       String
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("versao_minima_cliente")
}

model TabelaPrazo {
  id             String            @id @db.Uuid
  tipoAto        String            @map("tipo_ato")
  ramo           RamoProcessual
  versao         Int
  dias           Int
  unidade        UnidadePrazo
  fundamento     String
  fonteUrl       String            @map("fonte_url")
  vigenciaInicio DateTime          @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime?         @map("vigencia_fim") @db.Date
  contagem       ContagemPrazo
  politicaDobro  PoliticaDobro     @default(verificar) @map("politica_dobro")
  calculo        CalculoPrazo      @default(automatico)
  marcoInicial   String?           @map("marco_inicial")
  localDoAto     LocalDoAto?       @map("local_do_ato")
  alerta         String?
  status         StatusTabelaPrazo
  propostoPor    String            @map("proposto_por") @db.Uuid
  propostoEm     DateTime          @map("proposto_em") @db.Timestamptz(6)
  aprovadoPor    String?           @map("aprovado_por") @db.Uuid
  aprovadoEm     DateTime?         @map("aprovado_em") @db.Timestamptz(6)
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime          @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  ato TipoAto @relation(fields: [tipoAto], references: [codigo], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tipoAto, ramo, versao])
  @@map("tabela_prazo")
}

/// Perfil de acesso (HU07): global, só muda por migração. As permissões vêm do catálogo em código
/// (módulo identidade); perfil novo não exige mudar endpoints.
model Perfil {
  codigo       String   @id
  nome         String
  descricao    String
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  permissoes PerfilPermissao[]
  usuarios   UsuarioPerfil[]
  convites   ConviteMembro[]

  @@map("perfil")
}

/// O que cada perfil concede (permissões do catálogo em código).
model PerfilPermissao {
  perfil    String
  permissao String

  dono Perfil @relation(fields: [perfil], references: [codigo], onDelete: Restrict, onUpdate: Restrict)

  @@id([perfil, permissao])
  @@map("perfil_permissao")
}

/// Perfis de cada usuário, por tenant (RLS). admin_plataforma só no tenant plataforma (trigger).
model UsuarioPerfil {
  tenantId  String   @map("tenant_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  perfil    String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  dono    Perfil  @relation(fields: [perfil], references: [codigo], onDelete: Restrict, onUpdate: Restrict)

  @@id([usuarioId, perfil])
  @@index([tenantId])
  @@map("usuario_perfil")
}

enum AbrangenciaCalendario {
  nacional
  uf
  municipio
  tribunal
  comarca

  @@map("abrangencia_calendario")
}

enum TipoEventoCalendario {
  feriado
  recesso
  portaria
  indisponibilidade

  @@map("tipo_evento_calendario")
}

enum StatusEventoCalendario {
  rascunho
  aprovado

  @@map("status_evento_calendario")
}

/// Calendário forense global (HU13): mantido pelo curador, só vale aprovado por outra pessoa.
/// Sem tenant_id; aprovação e revogação protegidas por trigger no banco.
model EventoCalendario {
  id              String                 @id @db.Uuid
  abrangencia     AbrangenciaCalendario
  uf              String?                @db.Char(2)
  municipioIbge   String?                @map("municipio_ibge") @db.Char(7)
  tribunal        String?
  comarca         String?
  tipo            TipoEventoCalendario
  dataInicio      DateTime               @map("data_inicio") @db.Date
  dataFim         DateTime               @map("data_fim") @db.Date
  descricao       String
  atoNormativo    String                 @map("ato_normativo")
  urlAto          String                 @map("url_ato")
  status          StatusEventoCalendario
  propostoPor     String                 @map("proposto_por") @db.Uuid
  propostoEm      DateTime               @map("proposto_em") @db.Timestamptz(6)
  aprovadoPor     String?                @map("aprovado_por") @db.Uuid
  aprovadoEm      DateTime?              @map("aprovado_em") @db.Timestamptz(6)
  revogadoPor     String?                @map("revogado_por") @db.Uuid
  revogadoEm      DateTime?              @map("revogado_em") @db.Timestamptz(6)
  motivoRevogacao String?                @map("motivo_revogacao")
  criadoEm        DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime               @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@index([abrangencia, dataInicio])
  @@index([tribunal])
  @@map("evento_calendario")
}

/// Feriado local cadastrado pelo próprio escritório (HU13), com RLS. Só pode ser revogado.
model FeriadoLocal {
  id            String                @id @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  abrangencia   AbrangenciaCalendario
  uf            String?               @db.Char(2)
  municipioIbge String?               @map("municipio_ibge") @db.Char(7)
  tribunal      String?
  comarca       String?
  tipo          TipoEventoCalendario
  dataInicio    DateTime              @map("data_inicio") @db.Date
  dataFim       DateTime              @map("data_fim") @db.Date
  descricao     String
  atoNormativo  String                @map("ato_normativo")
  urlAto        String                @map("url_ato")
  cadastradoPor String                @map("cadastrado_por") @db.Uuid
  cadastradoEm  DateTime              @map("cadastrado_em") @db.Timestamptz(6)
  revogadoPor   String?               @map("revogado_por") @db.Uuid
  revogadoEm    DateTime?             @map("revogado_em") @db.Timestamptz(6)
  criadoEm      DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime              @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, dataInicio])
  @@map("feriado_local")
}

enum TipoOab {
  principal
  suplementar

  @@map("tipo_oab")
}

/// Advogado do tenant (HU11): dados de cadastro; a credencial fica no usuário (identidade).
model Advogado {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  usuarioId        String   @unique @map("usuario_id") @db.Uuid
  nome             String
  /// CPF só cifrado, com chave de dados identificada (v2.<id>.…; HU37, ADR-021). Nunca vai para log.
  cpfCifrado       String   @map("cpf_cifrado")
  /// Índice cego (HMAC-SHA256 em hex): mantém o CPF único sem guardá-lo em claro.
  cpfIndice        String   @unique @map("cpf_indice") @db.Char(64)
  celular          String
  emailsAdicionais String[] @default([]) @map("emails_adicionais")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  oabs    Oab[]

  @@index([tenantId])
  @@map("advogado")
}

/// Inscrição na OAB (HU11). Ativa é única por (numero, uf) em toda a base (índice parcial na migração).
model Oab {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  advogadoId   String    @map("advogado_id") @db.Uuid
  numero       String
  uf           String    @db.Char(2)
  tipo         TipoOab
  ativa        Boolean   @default(true)
  removidaEm   DateTime? @map("removida_em") @db.Timestamptz(6)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  advogado    Advogado                 @relation(fields: [advogadoId], references: [id], onDelete: Restrict)
  publicacoes PublicacaoDestinatario[]

  @@unique([tenantId, id])
  @@index([tenantId, advogadoId])
  @@map("oab")
}

/// Cliente do escritório (HU12). Documento: CPF ou CNPJ sem pontuação, opcional.
model Cliente {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  nome             String
  /// Documento só cifrado (HU37, ADR-021); null: cliente sem documento.
  documentoCifrado String?  @map("documento_cifrado")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  processos Processo[]

  @@unique([tenantId, id])
  @@index([tenantId, nome])
  @@map("cliente")
}

enum CoberturaProcesso {
  automatica
  parcial
  manual

  @@map("cobertura_processo")
}

/// Processo monitorado (HU12, RF03 e RF91): único por número CNJ no tenant.
model Processo {
  id                   String            @id @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  /// Só os 20 dígitos.
  numeroCnj            String            @map("numero_cnj") @db.Char(20)
  /// Sigla do tribunal deduzido do número (tabela em @pz/kernel/cnj).
  tribunal             String?
  ramo                 String?
  orgao                String?
  comarca              String?
  sigiloso             Boolean           @default(false)
  cobertura            CoberturaProcesso @default(automatica)
  motivoCobertura      String?           @map("motivo_cobertura")
  /// Conferência de painel a cada N dias (HU36); nulo: o padrão (5). Abaixo dos 10 dias da ciência tácita.
  conferenciaACadaDias Int?              @map("conferencia_a_cada_dias")
  clienteId            String?           @map("cliente_id") @db.Uuid
  criadoEm             DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime          @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cliente      Cliente?                 @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  publicacoes  PublicacaoDestinatario[]
  prazos       Prazo[]
  compromissos Compromisso[]
  conferencias ConferenciaPainel[]

  @@unique([tenantId, numeroCnj])
  @@unique([tenantId, id])
  @@index([tenantId, clienteId])
  @@index([tenantId, tribunal])
  /// GIN trigrama em orgao (busca parcial, HU28): só na migração, o Prisma não o modela.
  @@map("processo")
}

enum CanalNotificacao {
  email
  push
  whatsapp
  sms

  @@map("canal_notificacao")
}

/// Notificação enviada (HU30): uma linha por envio, com chave de idempotência única.
model Notificacao {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  usuarioId         String           @map("usuario_id") @db.Uuid
  prazoId           String?          @map("prazo_id") @db.Uuid
  canal             CanalNotificacao
  tipo              String
  chaveIdempotencia String           @unique @map("chave_idempotencia")
  template          String
  versaoTemplate    Int              @map("versao_template")
  destinatarios     String[]
  /// Dados do template; mínimos, sem partes nem teor (CLAUDE.md, seção 10).
  dados             Json
  /// Envio manual (HU32): referência do arquivo anexado no armazenamento (caminho, nome, tipo).
  anexo             Json?
  enviadaEm         DateTime?        @map("enviada_em") @db.Timestamptz(6)
  entregueEm        DateTime?        @map("entregue_em") @db.Timestamptz(6)
  abertaEm          DateTime?        @map("aberta_em") @db.Timestamptz(6)
  rejeitadaEm       DateTime?        @map("rejeitada_em") @db.Timestamptz(6)
  motivoRejeicao    String?          @map("motivo_rejeicao")
  idExterno         String?          @unique @map("id_externo")
  criadoEm          DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, usuarioId, criadoEm])
  @@index([tenantId, prazoId])
  @@map("notificacao")
}

/// Preferência por tipo e canal (HU30); sem linha, vale o padrão do tipo.
model PreferenciaNotificacao {
  tenantId      String           @map("tenant_id") @db.Uuid
  usuarioId     String           @map("usuario_id") @db.Uuid
  tipo          String
  canal         CanalNotificacao
  ativo         Boolean
  horarioResumo DateTime?        @map("horario_resumo") @db.Time(6)
  antecedencias Int[]            @default([])
  criadoEm      DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([usuarioId, tipo, canal])
  @@index([tenantId])
  @@map("preferencia_notificacao")
}

enum SituacaoLembrete {
  agendado
  enviado
  cancelado
  dispensado

  @@map("situacao_lembrete")
}

enum TipoLembrete {
  antecedencia
  insistencia

  @@map("tipo_lembrete")
}

/// Lembrete de prazo agendado (HU31): reprogramar cancela os futuros; nada é apagado.
model LembreteAgendado {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  prazoId      String           @map("prazo_id") @db.Uuid
  usuarioId    String           @map("usuario_id") @db.Uuid
  tipo         TipoLembrete
  /// Dias úteis antes do vencimento (0 = no dia).
  antecedencia Int
  vencimento   DateTime         @db.Date
  disparoEm    DateTime         @map("disparo_em") @db.Timestamptz(6)
  situacao     SituacaoLembrete @default(agendado)
  processadoEm DateTime?        @map("processado_em") @db.Timestamptz(6)
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Índices parciais (devidos e único entre os agendados) só na migração.
  @@index([tenantId, prazoId])
  @@map("lembrete_agendado")
}

/// Consentimento por canal (HU30, ADR-015): fora do e-mail, só envia com consentimento ativo.
/// Um ativo por usuário, canal e destino (índice parcial na migração); revogar não apaga.
model ConsentimentoCanal {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  usuarioId    String           @map("usuario_id") @db.Uuid
  canal        CanalNotificacao
  /// Push: ID do dispositivo; WhatsApp e SMS: telefone E.164.
  destino      String
  concedidoEm  DateTime         @map("concedido_em") @db.Timestamptz(6)
  revogadoEm   DateTime?        @map("revogado_em") @db.Timestamptz(6)
  origem       String
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("consentimento_canal")
}

enum PlataformaPush {
  ios
  android
  web

  @@map("plataforma_push")
}

/// Destino de push de um dispositivo (HU30): o token do sistema do aparelho, um por dispositivo.
model DestinoPush {
  id            String         @id @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  usuarioId     String         @map("usuario_id") @db.Uuid
  dispositivoId String         @unique @map("dispositivo_id") @db.Uuid
  plataforma    PlataformaPush
  token         String
  ativo         Boolean
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime       @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, usuarioId])
  @@map("destino_push")
}

/// Endereço que rejeitou ou marcou spam (HU30): global, não recebe de nenhum tenant.
model Supressao {
  email    String   @id
  motivo   String
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(6)

  @@map("supressao")
}

enum TipoAlvo {
  oab
  processo
  nome

  @@map("tipo_alvo")
}

/// Alvo de monitoramento da captura (HU17, ADR-014): global, uma consulta por alvo e execução.
model AlvoMonitoramento {
  id                 String    @id @db.Uuid
  tipo               TipoAlvo
  valor              String
  ativo              Boolean   @default(true)
  ultimoSucesso      DateTime? @map("ultimo_sucesso") @db.Timestamptz(6)
  ultimaJanelaFim    DateTime? @map("ultima_janela_fim") @db.Date
  ultimaChave        String?   @map("ultima_chave")
  proximaExecucao    DateTime? @map("proxima_execucao") @db.Timestamptz(6)
  falhasConsecutivas Int       @default(0) @map("falhas_consecutivas")
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  assinantes AlvoAssinante[]

  @@unique([tipo, valor])
  @@map("alvo_monitoramento")
}

enum SituacaoFonte {
  operacional
  degradada

  @@map("situacao_fonte")
}

/// Saúde de uma fonte de publicações (HU19): global, mantida pela captura.
model FonteCaptura {
  id                 String        @id
  situacao           SituacaoFonte @default(operacional)
  desde              DateTime      @default(now()) @db.Timestamptz(6)
  falhasConsecutivas Int           @default(0) @map("falhas_consecutivas")
  criadoEm           DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("fonte_captura")
}

/// Quem assina o alvo (HU17): por tenant, com RLS; `referencia` é a OAB ou o processo do tenant.
model AlvoAssinante {
  alvoId       String   @map("alvo_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  referencia   String   @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  alvo   AlvoMonitoramento @relation(fields: [alvoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, alvoId, referencia])
  @@index([alvoId])
  @@map("alvo_assinante")
}

enum TipoDocumentoLegal {
  termos
  privacidade
  cobertura

  @@map("tipo_documento_legal")
}

/// Documento legal versionado (HU38): global, só de inserção.
model DocumentoLegal {
  id               String             @id @db.Uuid
  tipo             TipoDocumentoLegal
  versao           String
  conteudo         String
  /// O que mudou em relação à versão anterior (tela de novo aceite).
  resumoAlteracoes String?            @map("resumo_alteracoes")
  publicadoEm      DateTime           @map("publicado_em") @db.Timestamptz(6)
  criadoEm         DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)

  aceites AceiteDocumento[]

  @@unique([tipo, versao])
  @@index([tipo, publicadoEm])
  @@map("documento_legal")
}

/// Aceite de um documento legal (HU38): por tenant (RLS), prova com IP e navegador.
model AceiteDocumento {
  tenantId     String   @map("tenant_id") @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  documentoId  String   @map("documento_id") @db.Uuid
  aceitoEm     DateTime @map("aceito_em") @db.Timestamptz(6)
  ip           String
  userAgent    String   @map("user_agent")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  documento DocumentoLegal @relation(fields: [documentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, usuarioId, documentoId])
  @@map("aceite_documento")
}

enum EscopoExportacao {
  titular
  escritorio

  @@map("escopo_exportacao")
}

enum SituacaoExportacao {
  pendente
  concluida

  @@map("situacao_exportacao")
}

/// Pedido de exportação de dados (HU38, LGPD art. 18), por tenant (RLS).
model ExportacaoDados {
  id           String             @id @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  usuarioId    String             @map("usuario_id") @db.Uuid
  escopo       EscopoExportacao
  situacao     SituacaoExportacao @default(pendente)
  solicitadaEm DateTime           @map("solicitada_em") @db.Timestamptz(6)
  concluidaEm  DateTime?          @map("concluida_em") @db.Timestamptz(6)
  expiraEm     DateTime?          @map("expira_em") @db.Timestamptz(6)
  criadoEm     DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, usuarioId])
  @@map("exportacao_dados")
}

/// Dado pessoal da trilha fora do hash (ADR-018): pseudonimizável sem quebrar a cadeia.
model AuditoriaDadoPessoal {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  usuarioId        String?   @map("usuario_id") @db.Uuid
  campo            String
  valor            String?
  sal              String?
  compromisso      String
  pseudonimizadoEm DateTime? @map("pseudonimizado_em") @db.Timestamptz(6)
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, usuarioId])
  @@map("auditoria_dado_pessoal")
}

/// Pedido de encerramento da conta do escritório (HU38): carência de 30 dias, cancelável.
model EncerramentoConta {
  tenantId      String    @id @map("tenant_id") @db.Uuid
  solicitadoPor String    @map("solicitado_por") @db.Uuid
  solicitadoEm  DateTime  @map("solicitado_em") @db.Timestamptz(6)
  efetivarEm    DateTime  @map("efetivar_em") @db.Timestamptz(6)
  canceladoEm   DateTime? @map("cancelado_em") @db.Timestamptz(6)
  efetivadoEm   DateTime? @map("efetivado_em") @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("encerramento_conta")
}

/// Conteúdo global e imutável de uma publicação (HU18, ADR-014), particionado por mês. A
/// aplicação não lê nem grava direto: escreve por `pz_registrar_publicacao` e lê pela view
/// `publicacao_do_tenant`. `teor_tsv` (coluna gerada) fica fora do modelo.
model PublicacaoConteudo {
  id                   String    @db.Uuid
  fonte                String
  idExterno            String    @map("id_externo")
  hashConteudo         String    @map("hash_conteudo")
  dataDisponibilizacao DateTime  @map("data_disponibilizacao") @db.Date
  dataPublicacao       DateTime? @map("data_publicacao") @db.Date
  numeroCnj            String?   @map("numero_cnj") @db.Char(20)
  teor                 String
  urlFonte             String    @map("url_fonte")
  metadados            Json      @default("{}") @db.JsonB
  adaptadorVersao      String    @map("adaptador_versao")
  capturadoEm          DateTime  @default(now()) @map("capturado_em") @db.Timestamptz(6)

  chaves        PublicacaoChave[]
  destinatarios PublicacaoDestinatario[]

  @@id([id, capturadoEm])
  @@index([dataDisponibilizacao, id])
  @@map("publicacao_conteudo")
}

/// Deduplicação global por fonte + hash do teor normalizado (ADR-014).
model PublicacaoChave {
  fonte        String
  hashConteudo String   @map("hash_conteudo")
  conteudoId   String   @map("conteudo_id") @db.Uuid
  capturadoEm  DateTime @map("capturado_em") @db.Timestamptz(6)

  conteudo PublicacaoConteudo @relation(fields: [conteudoId, capturadoEm], references: [id, capturadoEm], onDelete: Restrict, onUpdate: Restrict)

  @@id([fonte, hashConteudo])
  @@map("publicacao_chave")
}

/// Publicação recebida por um tenant (RLS): processo e OAB do próprio tenant, leitura.
model PublicacaoDestinatario {
  tenantId            String    @map("tenant_id") @db.Uuid
  conteudoId          String    @map("conteudo_id") @db.Uuid
  conteudoCapturadoEm DateTime  @map("conteudo_capturado_em") @db.Timestamptz(6)
  processoId          String?   @map("processo_id") @db.Uuid
  oabId               String?   @map("oab_id") @db.Uuid
  recebidaEm          DateTime  @default(now()) @map("recebida_em") @db.Timestamptz(6)
  lidaEm              DateTime? @map("lida_em") @db.Timestamptz(6)
  lidaPor             String?   @map("lida_por") @db.Uuid
  /// Só nas capturadas pelo nome (HU42): pendente, confirmada ou descartada.
  conferencia         String?
  conferidaEm         DateTime? @map("conferida_em") @db.Timestamptz(6)
  conferidaPor        String?   @map("conferida_por") @db.Uuid
  criadoEm            DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conteudo PublicacaoConteudo @relation(fields: [conteudoId, conteudoCapturadoEm], references: [id, capturadoEm], onDelete: Restrict, onUpdate: Restrict)
  processo Processo?          @relation(fields: [tenantId, processoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  oab      Oab?               @relation(fields: [tenantId, oabId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, conteudoId])
  @@index([tenantId, recebidaEm])
  @@index([tenantId, processoId])
  @@index([tenantId, oabId])
  @@map("publicacao_destinatario")
}

enum OrigemPrazo {
  djen
  manual
  painel

  @@map("origem_prazo")
}

enum StatusPrazo {
  a_confirmar
  pendente
  cumprido
  vencido
  cancelado

  @@map("status_prazo")
}

enum StatusCienciaPrazo {
  pendente
  confirmada

  @@map("status_ciencia_prazo")
}

/// Prazo de um ato do processo (HU16): sugerido pelo motor, só vale depois de confirmado.
model Prazo {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  processoId           String             @map("processo_id") @db.Uuid
  /// Destinatário da publicação de origem (tenant_id + conteudo_id), quando houver.
  publicacaoConteudoId String?            @map("publicacao_conteudo_id") @db.Uuid
  tipoAto              String             @map("tipo_ato")
  ramo                 RamoProcessual?
  dias                 Int?
  unidade              UnidadePrazo?
  inicio               DateTime?          @db.Date
  vencimento           DateTime?          @db.Date
  fimDoPrazo           DateTime?          @map("fim_do_prazo") @db.Timestamptz(6)
  fusoDoJuizo          String?            @map("fuso_do_juizo")
  vencimentoManual     Boolean            @default(false) @map("vencimento_manual")
  memoriaCalculo       Json               @map("memoria_calculo")
  entradaCalculo       Json?              @map("entrada_calculo")
  /// Entrada do cálculo (HU24): o ajuste recalcula pelo motor a partir dela.
  parametros           Json               @default("{}")
  /// Classificação com confiança baixa ou de revisão manual (HU24): a tela destaca.
  classificacaoIncerta Boolean            @default(false) @map("classificacao_incerta")
  motivoAjuste         String?            @map("motivo_ajuste")
  fundamento           String?
  origem               OrigemPrazo
  status               StatusPrazo        @default(a_confirmar)
  statusCiencia        StatusCienciaPrazo @default(pendente) @map("status_ciencia")
  responsavelId        String?            @map("responsavel_id") @db.Uuid
  versaoMotor          String?            @map("versao_motor")
  versaoTabela         Int?               @map("versao_tabela")
  jurisdicao           Json
  criadoEm             DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime           @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  versaoOtimista       Int                @default(1) @map("versao_otimista")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  processo Processo @relation(fields: [tenantId, processoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, vencimento])
  @@index([tenantId, status])
  @@index([tenantId, responsavelId, vencimento])
  @@index([tenantId, processoId])
  @@index([tenantId, inicio])
  @@index([tenantId, statusCiencia, vencimento])
  @@map("prazo")
}

enum StatusCasoCandidato {
  pendente
  aceito
  descartado

  @@map("status_caso_candidato")
}

/// Caso candidato à avaliação da IA, vindo de uma correção do advogado (HU22). Global, sem tenant.
model CasoCandidatoCuradoria {
  id                  String              @id @db.Uuid
  conteudoId          String              @map("conteudo_id") @db.Uuid
  teorAnonimizado     String              @map("teor_anonimizado")
  tipoAtoClassificado String?             @map("tipo_ato_classificado")
  tipoAtoCorrigido    String              @map("tipo_ato_corrigido")
  diasCitados         Int?                @map("dias_citados")
  diasCorrigidos      Int?                @map("dias_corrigidos")
  status              StatusCasoCandidato @default(pendente)
  motivoDecisao       String?             @map("motivo_decisao")
  decididoPor         String?             @map("decidido_por") @db.Uuid
  decididoEm          DateTime?           @map("decidido_em") @db.Timestamptz(6)
  criadoEm            DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm        DateTime            @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@index([status, id])
  @@map("caso_candidato_curadoria")
}

/// Compromisso do escritório (HU25): audiência, reunião, com lembretes em minutos antes.
model Compromisso {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  titulo             String
  dataHora           DateTime  @map("data_hora") @db.Timestamptz(6)
  local              String?
  processoId         String?   @map("processo_id") @db.Uuid
  lembretesMinutos   Int[]     @default([]) @map("lembretes_minutos")
  criadoPor          String    @map("criado_por") @db.Uuid
  canceladoEm        DateTime? @map("cancelado_em") @db.Timestamptz(6)
  motivoCancelamento String?   @map("motivo_cancelamento")
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  processo Processo? @relation(fields: [tenantId, processoId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, dataHora])
  @@map("compromisso")
}

enum EstadoCiencia {
  nao_enviado
  enviado
  entregue
  aberto
  visualizado
  confirmado
  cumprido

  @@map("estado_ciencia")
}

/// Token do link de ciência (HU33): só o hash, uso único, 7 dias; reemitir revoga os ativos.
model TokenCiencia {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  prazoId      String    @map("prazo_id") @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  hashToken    String    @unique @map("hash_token")
  expiraEm     DateTime  @map("expira_em") @db.Timestamptz(6)
  usadoEm      DateTime? @map("usado_em") @db.Timestamptz(6)
  usadoIp      String?   @map("usado_ip")
  revogadoEm   DateTime? @map("revogado_em") @db.Timestamptz(6)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, prazoId, usuarioId])
  @@map("token_ciencia")
}

/// Estado da ciência do prazo (HU33): só avança; confirmação com canal, IP e user agent.
model CienciaPrazo {
  prazoId       String        @id @map("prazo_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  estado        EstadoCiencia @default(nao_enviado)
  confirmadaPor String?       @map("confirmada_por") @db.Uuid
  confirmadaEm  DateTime?     @map("confirmada_em") @db.Timestamptz(6)
  canal         String?
  ip            String?
  userAgent     String?       @map("user_agent")
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, estado])
  @@map("ciencia_prazo")
}

/// Histórico verificável emitido (HU35): quais registros da trilha o PDF trouxe (RLS).
model VerificacaoHistorico {
  codigo       String   @id
  tenantId     String   @map("tenant_id") @db.Uuid
  entidade     String
  entidadeId   String   @map("entidade_id")
  sequencias   BigInt[]
  emitidaEm    DateTime @default(now()) @map("emitida_em") @db.Timestamptz(6)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, entidade, entidadeId])
  @@map("verificacao_historico")
}

/// Relatório exportado (HU29): pedido por usuário, gerado no worker, arquivo por 24 h (RLS).
model Relatorio {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  usuarioId         String    @map("usuario_id") @db.Uuid
  tipo              String
  formato           String
  filtros           Json      @default("{}")
  situacao          String    @default("pendente")
  linhas            Int?
  solicitadoEm      DateTime  @map("solicitado_em") @db.Timestamptz(6)
  concluidoEm       DateTime? @map("concluido_em") @db.Timestamptz(6)
  expiraEm          DateTime? @map("expira_em") @db.Timestamptz(6)
  /// Arquivo apagado do armazenamento após expirar o link (PZ-353).
  arquivoRemovidoEm DateTime? @map("arquivo_removido_em") @db.Timestamptz(6)
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, usuarioId, solicitadoEm(sort: Desc)])
  @@map("relatorio")
}

/// Feed privado da agenda (HU50): só o hash do token; um ativo por usuário.
model FeedAgenda {
