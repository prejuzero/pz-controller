{
  "name": "@pz/db",
  "version": "0.0.0",
  "private": true,
  "description": "Schema Prisma, migrações reversíveis, papéis, RLS e seeds (ADR-003).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./teste": "./src/teste/postgres.ts"
  },
  "scripts": {
    "gerar": "prisma generate",
    "migrar": "prisma migrate deploy",
    "reverter": "tsx src/reverter.ts",
    "semear": "prisma db seed",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@pz/config": "workspace:*",
    "@pz/kernel": "workspace:*",
    "@pz/observability": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@opentelemetry/core": "2.11.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prisma": "7.9.1",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
