{
  "name": "@pz/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system do portal: componentes sobre shadcn/ui (Radix) com os tokens de @pz/design-tokens, documentados no Storybook.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./estilos.css": "./src/estilos.css"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project componentes --coverage",
    "test:visual": "./scripts/visual.sh",
    "test:visual:atualizar": "./scripts/visual.sh --update",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@pz/design-tokens": "workspace:*",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@pz/config": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  }
}
