{
  "name": "pz-controller",
  "private": true,
  "description": "PrejuZero: captura de intimações, cálculo de prazos processuais e trilha de ciência.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "e2e": "pnpm --filter @pz/web e2e",
    "e2e:atualizar": "pnpm --filter @pz/web e2e:atualizar",
    "dev": "pnpm infra:up && pnpm db:migrate && pnpm db:seed && turbo run dev",
    "lint": "turbo run lint && pnpm lint:raiz && pnpm depcruise",
    "lint:raiz": "eslint --max-warnings=0 \"*.{js,mjs,cjs,ts}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "depcruise": "depcruise apps modules packages --config .dependency-cruiser.cjs",
    "gen:module": "node packages/config/src/gerar-modulo.mjs",
    "db:migrate": "pnpm --filter @pz/db migrar",
    "db:revert": "pnpm --filter @pz/db reverter",
    "db:seed": "pnpm --filter @pz/db semear",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "infra:up": "infra/docker/compose.sh up -d --build --wait && infra/docker/compose.sh run --rm armazenamento-init",
    "infra:up:obs": "infra/docker/compose.sh --profile observability up -d --build --wait && infra/docker/compose.sh run --rm armazenamento-init",
    "infra:up:apps": "infra/docker/compose.sh --profile apps up -d --build --wait && infra/docker/compose.sh run --rm armazenamento-init",
    "infra:down": "infra/docker/compose.sh --profile observability --profile apps down",
    "infra:reset": "infra/docker/compose.sh --profile observability --profile apps down -v && pnpm infra:up",
    "infra:logs": "infra/docker/compose.sh logs -f",
    "alertas:testar": "infra/docker/observabilidade/testar-alertas.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@pz/config": "workspace:*",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
